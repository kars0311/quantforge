.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# ── R ──
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# ── Data / pipeline outputs ──
data/raw/
data/processed/
output/
*.parquet
