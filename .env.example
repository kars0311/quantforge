# QuantForge environment config — copy to .env and fill in. NEVER commit .env.
# The authoritative variable inventory is docs/components/18-runtime-config.md; every variable
# listed there appears below with a comment, and no module reads a variable that is not listed.

# Anthropic API key for the app's runtime AI features (agent, NL interface).
# Generate one at https://console.anthropic.com under YOUR PERSONAL account.
# This is separate from Claude Code (the dev tool) — it needs no key here.
# Read by the `anthropic` SDK itself (nl_interface builds the client lazily); server-side only.
ANTHROPIC_API_KEY=...

# Hard spend caps in USD enforced by src/quantforge/ai/budget.py (estimate -> allow -> charge).
# Daily = UTC day. If either cap is UNSET (or blank/unparseable), the in-code dev defaults are
# 2 (daily) / 10 (total) — but with PUBLIC_MODE=on an unset cap resolves to 0 and budget.allow()
# denies EVERY call (fail-closed: an operator who forgot a cap gets zero AI calls, not a bill).
AI_BUDGET_USD_DAILY=2
AI_BUDGET_USD_TOTAL=10
# Kill-switch: "on" makes budget.allow() deny every AI call instantly (no restart needed).
AI_DISABLED=off
# Persistent spend ledger (JSON keyed by UTC day) written by budget.charge(). The rate-limit
# state file (ai_rate_limits.json) is derived from this path and sits beside it.
AI_LEDGER_PATH=data_cache/ai_ledger.json
# Per-session/IP AI calls allowed per sliding hour (guardrails.rate_limit); default 20 if unset.
AI_RATE_LIMIT_PER_HOUR=20

# "on" = public demo mode: parameter-only, no LLM-generated code execution,
# expensive AI paths gated behind DEMO_PASSCODE. Keep "off" for local dev.
# Read at call time by guardrails.public_mode() and budget — flipping it needs no restart.
PUBLIC_MODE=off
# Passcode the UI requires before a visitor may trigger live AI calls when PUBLIC_MODE=on.
# Leave blank in local dev; REQUIRED (non-empty) for any public deploy.
DEMO_PASSCODE=
