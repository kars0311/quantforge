{
  // Python: use the project venv everywhere (terminal, tests, debugging)
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],

  // Ruff handles linting AND formatting (matches the repo's quality gates)
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  // R: use httpgd for plots inside VS Code instead of a popup window
  "r.plot.useHttpgd": true,
  "r.rterm.mac": "/opt/homebrew/bin/R",
  "r.bracketedPaste": true,

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
